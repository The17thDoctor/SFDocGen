@page "/ref/library/{LibraryName}/table/{TableName}"
@using SFDocGen.Blazor.Components
@using SFDocGen.Services.Frontend


<SFDocValueView TValue="SFLibraryTable" Value="Table" Signature="@SignatureHelper.Create(Table, true)" CustomName="@SignatureHelper.Create(Table)" />


@code {
    [Parameter]
    public string TableName { get; set; } = string.Empty;

    [Parameter]
    public string LibraryName { get; set; } = string.Empty;

    public SFLibraryTable Table { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFLibrary? library = Storage.Documentation.Libraries.GetValueOrDefault(LibraryName);
        if (library == null)
        {
            Navigation.NotFound();
            return;
        }

        Table = library.Tables.GetValueOrDefault(TableName)!;
        if (Table == null)
        {
            Navigation.NotFound();
            return;
        }
    }

    private string GetSignature()
    {
        if (Table.Parent.Name == "builtin") return $"{Table.Name} = {{}}";
        return $"{Table.Parent.Name}.{Table.Name} = {{}}";
    }
}