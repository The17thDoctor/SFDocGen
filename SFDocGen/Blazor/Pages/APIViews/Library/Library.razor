@page "/ref/library/{Name}"

<CustomPageTitle Title="@Value.Name" />

<MudTooltip Placement="Placement.Right" Arrow Text="Library">
    <div class="d-flex flex-row mud-secondary-text">
        <MudIcon Class="my-auto mr-1" Icon="@Icons.Material.Filled.Class" Size="Size.Large" />
        <MudText Typo="Typo.h4">@Value.Name</MudText>
    </div>
</MudTooltip>

<MudText Typo="Typo.body1">@Value.Description</MudText>
<MudDivider/>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;
    public SFLibrary Value { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Value = Storage.Documentation.Libraries.GetValueOrDefault(Name)!;
        if (Value == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}
