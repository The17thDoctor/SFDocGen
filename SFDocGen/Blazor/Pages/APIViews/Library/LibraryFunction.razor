@page "/ref/library/{LibraryName}/function/{FunctionName}"
@using SFDocGen.Blazor.Components
@using SFDocGen.Services.Frontend


<SFDocValueView TValue="SFLibraryFunction" Value="Function" Signature="@SignatureHelper.Create(Function, true, true)" CustomName="@SignatureHelper.Create(Function)" />


@code {
    [Parameter]
    public string FunctionName { get; set; } = string.Empty;

    [Parameter]
    public string LibraryName { get; set; } = string.Empty;

    public SFLibraryFunction Function { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFLibrary? @class = Storage.Documentation.Libraries.GetValueOrDefault(LibraryName);
        Function = @class?.Functions.GetValueOrDefault(FunctionName)!;

        if (Function == null)
        {
            Navigation.NotFound();
            return;
        }
    }

    private string GetFunctionName(bool includeParams)
    {
        string paramList = includeParams ? string.Join(", ", Function.Parameters.Select(p => p.Name)) : string.Empty;

        if (Function.Parent.Name == "builtin") return $"{Function.Name}({paramList})";
        else return $"{Function.Parent.Name}.{Function.Name}({paramList})";
    }
}