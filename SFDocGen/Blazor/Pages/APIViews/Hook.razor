@page "/ref/hook/{Name}"
@using SFDocGen.Blazor.Components
@using SFDocGen.Services.Frontend


<SFDocValueView TValue="SFHook" Value="@Value" Signature="@SignatureHelper.Create(Value)" />


@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;
    public SFHook Value { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Value = Storage.Documentation.Hooks.GetValueOrDefault(Name)!;
        if (Value == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}