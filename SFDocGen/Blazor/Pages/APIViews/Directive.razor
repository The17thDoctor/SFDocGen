@page "/ref/directive/{Name}"
@using SFDocGen.Blazor.Components
@using SFDocGen.Services.Frontend


<SFDocValueView TValue="SFDirective" Value="Value" Signature="@SignatureHelper.Create(Value)" />


@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;
    public SFDirective Value { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Value = Storage.Documentation.Directives.GetValueOrDefault(Name)!;
        if (Value == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}