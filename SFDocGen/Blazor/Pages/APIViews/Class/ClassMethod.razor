@page "/ref/class/{ClassName}/method/{MethodName}"
@using SFDocGen.Blazor.Components
@using SFDocGen.Services.Frontend

<SFDocValueView TValue="SFClassMethod" Value="Method" Signature="@SignatureHelper.Create(Method, true, true)" CustomName="@SignatureHelper.Create(Method)" />

@code {
    [Parameter]
    public string MethodName { get; set; } = string.Empty;

    [Parameter]
    public string ClassName { get; set; } = string.Empty;

    public SFClassMethod Method { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFClass? @class = Storage.Documentation.Classes.GetValueOrDefault(ClassName);
        if (@class == null)
        {
            Navigation.NotFound();
            return;
        }

        Method = @class.Methods.GetValueOrDefault(MethodName)!;
        if (Method == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}