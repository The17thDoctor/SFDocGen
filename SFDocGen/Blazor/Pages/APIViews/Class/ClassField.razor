@page "/ref/class/{ClassName}/field/{FieldName}"
@using SFDocGen.Blazor.Components
@using SFDocGen.Services.Frontend

<SFDocValueView TValue="SFClassField" Value="Field" CustomName="@SignatureHelper.Create(Field)" />

@code {
    [Parameter]
    public string FieldName { get; set; } = string.Empty;

    [Parameter]
    public string ClassName { get; set; } = string.Empty;

    public SFClassField Field { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFClass? @class = Storage.Documentation.Classes.GetValueOrDefault(ClassName);
        if (@class == null)
        {
            Navigation.NotFound();
            return;
        }

        Field = @class.Fields.GetValueOrDefault(FieldName)!;
        if (Field == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}