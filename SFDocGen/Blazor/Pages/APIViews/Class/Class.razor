@page "/ref/class/{Name}"
@using SFDocGen.Services.Frontend


<SFDocValueView TValue="SFClass" Value="Value" ContentPlacement="ContentPlacement.Description">
    <MudGrid Spacing="6" Justify="Justify.Center">
        <MudItem Class="flex-1">
            <MudPaper Elevation="3">
                <MudStack Spacing="0">
                    <MudText Align="Align.Center" Typo="Typo.h5" Class="py-1">METHODS</MudText>
                    @{
                        foreach (var method in Value.Methods.Values)
                        {
                            <MudButton @key="method" StartIcon="@IconsHelper.SFDocIcon(method)" Class="rounded-0 justify-start">
                                <MudText Typo="Typo.subtitle2">@(Name + ":" + method.Name + "()")</MudText>
                            </MudButton>
                        }
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem Class="flex-1">
            <MudPaper Elevation="3">
                <MudText Align="Align.Center" Typo="Typo.h5" Class="py-1">FIELDS</MudText>
            </MudPaper>
        </MudItem>
        <MudItem Class="flex-1">
            <MudPaper Elevation="3" Class="rounded-lg">
                <MudText Align="Align.Center" Typo="Typo.h5" Class="py-1">OPERATORS</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</SFDocValueView>


@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;
    public SFClass Value { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Value = Storage.Documentation.Classes.GetValueOrDefault(Name)!;
        if (Value == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}
