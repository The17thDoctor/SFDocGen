@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using MudBlazor.Utilities
@using SFDocGen.Blazor.Components


@inherits LayoutComponentBase
@inject IHostEnvironment HostEnvironment
@inject ProtectedLocalStorage SessionStorage


<MudThemeProvider IsDarkMode="@ThemeProvider.IsDarkMode" Theme="@ThemeProvider.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Loading)
{
    <MudLayout Class="d-flex">
        @if (Loading)
        {
            <MudContainer MaxWidth="MaxWidth.False" Class="d-flex align-content-center my-auto">
                <MudContainer MaxWidth="MaxWidth.False" Class="d-flex align-content-center justify-center mx-auto">
                    <MudProgressCircular Class="my-auto mr-6" Color="Color.Default" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.h2">Loading...</MudText>
                </MudContainer>
            </MudContainer>
        }
    </MudLayout>

    return;
}

<MudHotkey Key="JsKey.KeyK" KeyModifiers="@(new List<JsKeyModifier>() { JsKeyModifier.ControlLeft })" OnHotkeyPressed="FocusSearch" />

<MudLayout>
    <!-- App Bar -->
    <MudAppBar Gutters="true" Elevation="2">
        <!-- Logo -->
        <MudLink Href="/" Underline="Underline.None" Typo="Typo.h1" Color="Color.Inherit">✨SFDOCGEN✨</MudLink>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />

        <!-- Navigation Buttons -->
        <MudButton Href="/ref" Color="Color.Inherit">API Reference</MudButton>
        <MudButton Href="/doc" Color="Color.Inherit">Documentation</MudButton>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudButton Href="/api/swagger" Color="Color.Inherit">Backend API</MudButton>
        <MudSpacer />

        <!-- Search Bar -->
        <SearchBar @ref="_searchBar" />
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />

        <!-- Theme Switching -->
        <MudToggleIconButton Toggled="@ThemeProvider.IsDarkMode"
                             ToggledChanged="ChangeTheme"
                             Color="Color.Inherit"
                             ToggledColor="Color.Inherit"
                             Icon="@Icons.Material.Filled.LightMode"
                             ToggledIcon="@Icons.Material.Filled.DarkMode" />
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />

        <!-- Github Link -->
        <MudTooltip Arrow Text="Check out the source code!">
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" 
                           ButtonType="ButtonType.Button"
                           Color="Color.Inherit"
                           Target="_blank"
                           Href="https://github.com/The17thDoctor/SFDocGen" />
        </MudTooltip>
    </MudAppBar>

    <!-- Navigation Drawer -->
    <MudDrawer Width="320px" Open Elevation="2" Class="z-100" ClipMode="@DrawerClipMode.Docked">
        <MudNavMenu Rounded="true" Margin="Margin.Dense" Class="pa-2">
            <MudText Class="pl-6" Align="Align.Left" Typo="Typo.h6">API Reference</MudText>
            <APITreeView />
        </MudNavMenu>
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Class="d-flex h-full" >
        <MudContainer Class="pa-4" MaxWidth="MaxWidth.False" Gutters="false">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    protected bool Loading { get; set; } = true;
    private SearchBar? _searchBar;

    protected override void OnParametersSet()
    {
        base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            try
            {
                var result = await SessionStorage.GetAsync<string>("theme");
                if (result.Success)
                {
                    ThemeProvider.SetTheme(result.Value == "dark");
                }

                Loading = false;
                StateHasChanged();
            }
            catch (TaskCanceledException) { }
        }
    }

    protected void ChangeTheme()
    {
        ThemeProvider.SwitchTheme();
        SessionStorage.SetAsync("theme", ThemeProvider.IsDarkMode ? "dark" : "light");
    }

    protected void FocusSearch(HotkeyEventArgs args)
    {
        _searchBar?.Focus();
    }
}