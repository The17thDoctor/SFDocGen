@using MudBlazor.Utilities
@using SFDocGen.Blazor.Components
@using SFDocGen.Extensions
@using SFDocGen.Model.Abstraction
@using SFDocGen.Services.Frontend

@inherits LayoutComponentBase
@inject IHttpClientFactory HttpFactory

<MudThemeProvider @bind-IsDarkMode="IsDarkMode" Theme="@_theme" @rendermode="InteractiveServer" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudHotkey Key="JsKey.KeyK" KeyModifiers="@(new List<JsKeyModifier>() { JsKeyModifier.ControlLeft })" OnHotkeyPressed="FocusSearch" />

<MudLayout>
    <MudAppBar Gutters="true" Elevation="2">
        <MudLink Href="/" Color="Color.Default" Underline="Underline.None" Style="font-weight: 900" Typo="Typo.h5">✨SFDOCGEN✨</MudLink>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudButton Href="/ref" Color="Color.Primary">API Reference</MudButton>
        <MudButton Href="/doc" Color="Color.Primary">Documentation</MudButton>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudButton Href="/api/swagger" Color="Color.Secondary">Backend API</MudButton>
        <MudSpacer />
        <MudAutocomplete 
            @ref="_searchField"
            ValueChanged="@SearchItemSelected"
            Placeholder="Search (Ctrl+K)"
            Margin="Margin.Dense"
            AdornmentIcon="@Icons.Material.Filled.Search"
            Variant="Variant.Outlined"
            T="SFDocValue"
            MaxItems="null"
            ToStringFunc="@(value => value != null ? SignatureHelper.Create(value) : null)"
            SearchFunc="@Search">
            <ItemTemplate>
                <div class="d-flex">
                    <MudIcon Icon="@IconsHelper.SFDocIcon(context)" Class="mr-1" />
                    <MudText Inline Typo="Typo.subtitle2">@SignatureHelper.Create(context)</MudText>
                </div>
                <p />
                <MudText Typo="Typo.caption">@context.Description</MudText>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText Typo="Typo.body1">No match found.</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudTooltip Arrow Placement="Placement.Bottom" Text="Theme switching is not yet implemented either :)">
            <MudToggleIconButton Disabled @bind-Toggled="IsDarkMode" Color="Color.Inherit" Icon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit" ToggledIcon="@Icons.Material.Filled.DarkMode" title="@(IsDarkMode ? "Dark" : "Light")" />
        </MudTooltip>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudTooltip Arrow Text="Check out the source code!">
            <MudIconButton Target="_blank" ButtonType="ButtonType.Button" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/The17thDoctor/SFDocGen" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer Width="320px" Open Elevation="2" Class="z-100" ClipMode="@DrawerClipMode.Docked">
        <MudNavMenu Rounded="true" Margin="Margin.Dense" Class="pa-2">
            <MudText Class="pl-6" Align="Align.Left" Typo="Typo.h6">API Reference</MudText>
            <APITreeView @ref="_apiTree" />
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="d-flex h-full" >
        <MudContainer Class="pa-4" MaxWidth="MaxWidth.False" Gutters="false">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    public bool IsDarkMode { get; set; } = true;

    private MudTheme _theme = new();
    private HttpClient _httpClient = default!;
    private MudAutocomplete<SFDocValue>? _searchField;
    private APITreeView? _apiTree;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpFactory.CreateClient("APIClient");
        await base.OnInitializedAsync();
    }

    protected async Task<IEnumerable<SFDocValue>> Search(string? search, CancellationToken cancel)
    {
        if (search == null || search.Length < 2) return [];
        var result = Storage.Documentation.Find(value =>
        {
            if (value is SFParameter or SFReturnValue or SFTableField) return false;
            return SignatureHelper.Create(value).Contains(search, StringComparison.InvariantCultureIgnoreCase);
        });

        return result;
    }

    protected void SearchItemSelected(SFDocValue? value)
    {
        if (value == null) return;

        string uri = "/ref/" + value.Id();
        Navigation.NavigateTo(uri);
    }

    protected void FocusSearch(HotkeyEventArgs args)
    {
        _searchField?.FocusAsync();
    }
}