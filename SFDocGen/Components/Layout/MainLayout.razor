@using MudBlazor.Utilities

@inherits LayoutComponentBase
@inject IHttpClientFactory HttpFactory

<MudThemeProvider @bind-IsDarkMode="IsDarkMode" Theme="@_theme" @rendermode="InteractiveServer" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudHotkey Key="JsKey.KeyK" KeyModifiers="@(new List<JsKeyModifier>() { JsKeyModifier.ControlLeft })" OnHotkeyPressed="FocusSearch" />

<MudLayout>
    <MudAppBar Gutters="false" Class="pr-4" Elevation="2">
        <a href="/">
            <MudText Class="mx-4" Style="font-weight: 900" Align="Align.Center" Typo="@Typo.h5">✨SFDOCGEN✨</MudText>
        </a>
        <MudButton Href="/api/swagger" Color="Color.Inherit">
            <MudIcon Icon="@Icons.Material.Filled.Api" Class="me-2"/>
            <MudText Typo="Typo.button">API Documentation</MudText>
        </MudButton>
        <MudSpacer />
        <MudAutocomplete @ref="_searchField" Placeholder="Search (Ctrl+K)" On Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" T="SearchResult" SearchFunc="@Search">
            <ItemTemplate>
                <MudText Typo="Typo.body2">@context.Name</MudText>
                <p/>
                <MudText Typo="Typo.caption">@context.Description</MudText>
            </ItemTemplate>
        </MudAutocomplete>
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudToggleIconButton @bind-Toggled="IsDarkMode" Color="Color.Inherit" Icon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit" ToggledIcon="@Icons.Material.Filled.DarkMode" title="@(IsDarkMode ? "Dark" : "Light")" />
        <MudDivider FlexItem="true" Vertical="true" Class="my-4 mx-4" />
        <MudTooltip Text="Check out the source code!">
            <MudIconButton Target="_blank" ButtonType="ButtonType.Button" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/The17thDoctor/SFDocGen" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer Width="320px" Open Elevation="2" Class="z-100" ClipMode="@DrawerClipMode.Docked">
        <MudNavMenu Rounded="true" Margin="Margin.Dense" Class="pa-2">
            <DocTreeView/>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    public bool IsDarkMode { get; set; } = true;

    private MudTheme _theme = new();
    private HttpClient _httpClient = default!;
    private MudAutocomplete<SearchResult>? _searchField;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpFactory.CreateClient("APIClient");
        await base.OnInitializedAsync();
    }

    protected async Task<IEnumerable<SearchResult>> Search(string? search, CancellationToken cancel)
    {
        if (search == null || search.Length < 2) return [];
        return await _httpClient.GetFromJsonAsync<IEnumerable<SearchResult>>($"search?term={search}", cancel) ?? [];
    }

    protected void FocusSearch(HotkeyEventArgs args)
    {
        _searchField?.FocusAsync();
    }
}