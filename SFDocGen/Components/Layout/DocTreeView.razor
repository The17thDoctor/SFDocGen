@using SFDocGen.Model.Abstraction
@using SFDocGen.Services.Frontend

<MudTreeView SelectedValueChanged="SelectedValueChanged" T="SFDocValue" Dense @bind-Items="TreeItems">
    <ItemTemplate>
        <MudTreeViewItem Value="@context.Value" Text="@context.Text" @bind-Items="@context.Children">
        </MudTreeViewItem>
    </ItemTemplate>
</MudTreeView>

@code {
    public List<TreeItemData<SFDocValue>> TreeItems { get; set; } = [];

    private Dictionary<Type, string> _docTypePath = new()
    {
        { typeof(SFHook), "hook" },
        { typeof(SFDirective), "directive" },

        { typeof(SFClass), "class" },
        { typeof(SFClassField), "field" },
        { typeof(SFClassMethod), "method" },
        { typeof(SFClassOperator), "operator" },

        { typeof(SFLibrary), "library" },
        { typeof(SFLibraryField), "field" },
        { typeof(SFLibraryTable), "table" },
        { typeof(SFLibraryFunction), "function" },

        { typeof(SFTable), "table" },
        { typeof(SFTableField), "field" },

    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        PopulateTree();
    }

    private void PopulateTree()
    {
        var sfdoc = Storage.Documentation;

        TreeItems.Add(new()
        {
            Text = "Libraries",
            Icon = Icons.Material.Filled.Book,
            Children = CreateChildren(sfdoc.Libraries.Values)
        });

        TreeItems.Add(new()
        {
            Text = "Classes",
            Icon = Icons.Custom.FileFormats.FileCode,
            Children = CreateClasses(sfdoc.Classes.Values)
        });
    }

    public void SelectedValueChanged(SFDocValue? value)
    {
        if (value == null) return;
        Navigation.NavigateTo(CreateLink(value));
    }

    private List<TreeItemData<SFDocValue>> CreateClasses(IEnumerable<SFClass> classes)
    {
        List<TreeItemData<SFDocValue>> list = [];
        foreach (SFClass @class in classes)
        {
            List<TreeItemData<SFDocValue>> children = [];

            if (@class.Methods.Any())
            {
                children.Add(new()
                {
                    Text = "Methods",
                    Children = CreateChildren(@class.Methods.Values)
                });
            }

            if (@class.Fields.Any())
            {
                children.Add(new()
                {
                    Text = "Fields",
                    Children = CreateChildren(@class.Fields.Values)
                });
            }

            if (@class.Operators.Any())
            {
                children.Add(new()
                {
                    Text = "Operators",
                    Children = CreateChildren(@class.Operators.Values)
                });
            }

            list.Add(new()
            {
                Text = @class.DocName ?? @class.Name,
                Value = @class,
                Children = children
            });
        }

        return list;
    }

    private List<TreeItemData<SFDocValue>> CreateChildren(IEnumerable<SFDocValue> items)
    {
        List<TreeItemData<SFDocValue>> list = [];

        foreach (SFDocValue item in items)
        {
            list.Add(new()
            {
                Text = item.Name,
                Value = item
            });
        }

        list.OrderBy(i => i.Text, StringComparer.InvariantCultureIgnoreCase);
        return list;
    }

    private TreeItemData<SFDocValue> CreateItem(SFDocValue value, string? icon = null)
    {
        return new()
        {
            Text = value.Name,
            Value = value,
            Icon = icon
        };
    }

    private string CreateLink(SFDocValue value)
    {
        string path = "/";

        if (typeof(IChildObject<SFDocValue>).IsAssignableTo(value.GetType()))
        {
            IChildObject<SFDocValue> child = (IChildObject<SFDocValue>)value;
            path += $"{_docTypePath[child.Parent.GetType()]}/{child.Parent.Name}";
        }

        path += $"{_docTypePath[value.GetType()]}/{value.Name}";
        return path;
    }

    private string RealmPicture(SFDocValue? value)
    {
        return CustomIcons.Shared;
    }
}
