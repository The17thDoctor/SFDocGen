@using SFDocGen.Services.Frontend
@using UriMapper = SFDocGen.Services.Frontend.SFDocUriMapper


<MudTreeView @ref="_treeView" T="string" Dense @bind-Items="TreeItems" SelectionMode="SelectionMode.SingleSelection" SelectedValueChanged="@Navigate">
    <ItemTemplate>
        <MudTreeViewItem Icon="@context.Icon" Value="@context.Value" Text="@context.Text" @bind-Items="@context.Children" />
    </ItemTemplate>
</MudTreeView>

@code {
    public List<TreeItemData<string>> TreeItems { get; set; } = [];
    private MudTreeView<string>? _treeView;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Populate();
    }

    protected void Navigate(string uri)
    {
        if (uri == string.Empty) return;
        Navigation.NavigateTo(uri);
    }

    protected void Populate()
    {
        var documentation = Storage.Documentation;

        TreeItemData<string> hookHeader = new() { Text = "Hooks", Value = string.Empty, Icon = Icons.Material.Filled.Settings };
        hookHeader.Children = documentation.Hooks.Values.Select(hook => new TreeItemData<string>() { Text = hook.Name, Value = UriMapper.Map(hook), Icon = CustomIcons.RealmIcon(hook) }).ToList();
        TreeItems.Add(hookHeader);

        TreeItemData<string> libraryHeader = new() { Text = "Libraries", Value = string.Empty, Icon = Icons.Material.Filled.MenuBook };
        libraryHeader.Children = documentation.Libraries.Values.Select(Populate).ToList();
        TreeItems.Add(libraryHeader);

        TreeItemData<string> classHeader = new() { Text = "Types", Value = string.Empty, Icon = Icons.Custom.FileFormats.FileCode };
        classHeader.Children = documentation.Classes.Values.Select(Populate).ToList();
        TreeItems.Add(classHeader);

        TreeItemData<string> tableHeader = new() { Text = "Structures", Value = string.Empty, Icon = Icons.Material.Filled.AutoAwesomeMotion };
        tableHeader.Children = documentation.Tables.Values.Select(table => new TreeItemData<string> { Text = table.Name, Value = UriMapper.Map(table), Icon = CustomIcons.RealmIcon(table) }).ToList();
        TreeItems.Add(tableHeader);

        TreeItemData<string> directiveHeader = new() { Text = "Preprocessor Directives", Value = string.Empty, Icon = Icons.Material.Filled.Code };
        directiveHeader.Children = documentation.Directives.Values.Select(directive => new TreeItemData<string>() { Text = directive.Name, Value = UriMapper.Map(directive), Icon = Icons.Material.Filled.Code }).ToList();
        TreeItems.Add(directiveHeader);
    }

    protected TreeItemData<string> Populate(SFClass @class)
    {
        TreeItemData<string> node = new() { Text = @class.Name, Value = UriMapper.Map(@class), Icon = Icons.Material.Filled.InsertDriveFile };
        List<TreeItemData<string>> children = [];

        if (@class.Fields.Any())
        {
            TreeItemData<string> fieldHeader = new() { Text = "Fields", Value = string.Empty, Icon = Icons.Material.Rounded.ViewList };
            fieldHeader.Children = @class.Fields.Values.Select(field => new TreeItemData<string>() { Text = $"{@class.DocName ?? @class.Name}.{field.Name}", Value = UriMapper.Map(field), Icon = CustomIcons.RealmIcon(@class) }).ToList();
            children.Add(fieldHeader);
        }

        if (@class.Methods.Any())
        {
            TreeItemData<string> methodHeader = new() { Text = "Methods", Value = string.Empty, Icon = Icons.Material.Filled.DataObject };
            methodHeader.Children = @class.Methods.Values.Select(method => new TreeItemData<string>() { Text = $"{@class.DocName ?? @class.Name}:{method.Name}()", Value = UriMapper.Map(method), Icon = CustomIcons.RealmIcon(method) }).ToList();
            children.Add(methodHeader);
        }

        if (@class.Operators.Any())
        {
            TreeItemData<string> operatorHeader = new() { Text = "Operators", Value = string.Empty, Icon = Icons.Material.Filled.Calculate };
            operatorHeader.Children = @class.Operators.Values.Select(@operator => new TreeItemData<string>() { Text = FormatOperator(@operator), Value = UriMapper.Map(@operator), Icon = Icons.Material.Filled.Superscript }).ToList();
            children.Add(operatorHeader);
        }

        node.Children = children;
        return node;
    }

    protected TreeItemData<string> Populate(SFLibrary library)
    {
        TreeItemData<string> node = new() { Text = library.Name, Value = UriMapper.Map(library), Icon = Icons.Material.Filled.Book };
        List<TreeItemData<string>> children = [];

        // Special case for the builtin library to make documentation clearer.
        string libraryPrefix = library.Name == "builtin" ? string.Empty : $"{library.DocName ?? library.Name}.";

        if (library.Fields.Any())
        {
            TreeItemData<string> fieldHeader = new() { Text = "Fields", Value = string.Empty, Icon = Icons.Material.Rounded.ViewList };
            fieldHeader.Children = library.Fields.Values.Select(field => new TreeItemData<string>() { Text = $"{libraryPrefix}{field.Name}", Value = UriMapper.Map(field), Icon = CustomIcons.RealmIcon(field) }).ToList();
            children.Add(fieldHeader);
        }

        if (library.Functions.Any())
        {
            TreeItemData<string> functionHeader = new() { Text = "Functions", Value = string.Empty, Icon = Icons.Material.Filled.Functions };
            functionHeader.Children = library.Functions.Values.Select(function => new TreeItemData<string>() { Text = $"{libraryPrefix}{function.Name}()", Value = UriMapper.Map(function), Icon = CustomIcons.RealmIcon(function) }).ToList();
            children.Add(functionHeader);
        }

        if (library.Tables.Any())
        {
            TreeItemData<string> tableHeader = new() { Text = "Tables", Value = string.Empty, Icon = Icons.Material.Filled.DataArray };
            tableHeader.Children = library.Tables.Values.Select(table => new TreeItemData<string>() { Text = $"{libraryPrefix}{table.Name}", Value = UriMapper.Map(table), Icon = CustomIcons.RealmIcon(table) }).ToList();
            children.Add(tableHeader);
        }

        node.Children = children;
        return node;
    }

    private string FormatOperator(SFClassOperator @operator)
    {
        Dictionary<string, string> operatorFormats = new()
        {
            { "mul", "{0} * {1}" },
            { "div", "{0} / {1}" },
            { "eq", "{0} == {1}" },
            { "add", "{0} + {1}" },
            { "sub", "{0} - {1}" },
            { "unm", "-{0}" }
        };

        string identifier = @operator.Name?.Split('_')[0] ?? string.Empty;

        if (!operatorFormats.TryGetValue(identifier, out string? format))
        {
            return @operator.Name ?? "UNKNOWN OPERATOR";
        }

        if (@operator.RightOperand != null)
        {
            return string.Format(format, @operator.LeftOperand, @operator.RightOperand);
        }
        else
        {
            return string.Format(format, @operator.LeftOperand);
        }
    }
}
