@using SFDocGen.Model.Abstraction
@using SFDocGen.Services.Frontend

<MudText>
    <b class="mud-secondary-text">@Parameter.Name</b>:
    @if (!Parameter.Types.Any())
    {
        <b>unknown</b>                 
    }
    @foreach (string type in Parameter.Types)
    {
        string? uri = FindReference(type);

        if (uri != null)
        {
            <b class="ml-1"><a class="mud-info-text" href="@uri">@type</a></b>
        }
        else
        {
            <b class="ml-1">@type</b>
        }
    }
</MudText>

@if (Parameter.Description != null)
{
    @foreach (string line in Parameter.Description.Split('\n'))
    {
        <MudText>@line</MudText>
    }
}
<br />

@code {
    [Parameter, EditorRequired]
    public SFParameter Parameter { get; set; }

    public string? FindReference(string typeName)
    {
        if (Storage.Documentation.Classes.TryGetValue(typeName, out SFClass? @class))
        {
            return SFDocUriMapper.Map(@class);
        }
        else if (Storage.Documentation.Tables.TryGetValue(typeName, out SFTable? table))
        {
            return SFDocUriMapper.Map(table);
        }

        return null;
    }
}
