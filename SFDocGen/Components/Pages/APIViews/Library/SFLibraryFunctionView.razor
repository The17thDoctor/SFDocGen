@page "/ref/library/{LibraryName}/function/{FunctionName}"
@using SFDocGen.Components.UI

<CustomPageTitle Title="@GetSignature()" />

<MudTooltip Placement="Placement.Right" Arrow Text="Field">
    <div class="d-flex flex-row mud-secondary-text">
        <MudIcon Class="my-auto mr-1" Icon="@Icons.Material.Filled.DataObject" Size="Size.Large" />
        <MudText Typo="Typo.h4">@GetSignature(includeParams: false)</MudText>
    </div>
</MudTooltip>

<MudDivider />

<MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
    <CodeHighlight CodeLanguage="lua" Code="@GetSignature()" />

    <MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
        <RealmText Value="@Function" />

        
        @foreach (string line in (Function.Description ?? string.Empty).Split("\n"))
        {
            <MudText Typo="Typo.body1">@line</MudText>
        }

        <br />

        @if (Function.Parameters.Any())
        {
            <MudText Color="Color.Tertiary" Typo="Typo.h6">Parameters</MudText>
            @foreach (var parameter in Function.Parameters)
            {
                <ParameterView Parameter="parameter" />
            }
            <br />
        }

        @if (Function.Usage != null)
        {
            <MudText Color="Color.Tertiary" Typo="Typo.h6">Usage</MudText>
            <CodeHighlight CodeLanguage="lua" Code="@Function.Usage" />
        }
    </MudContainer>
</MudContainer>


@code {
    [Parameter]
    public string FunctionName { get; set; } = string.Empty;

    [Parameter]
    public string LibraryName { get; set; } = string.Empty;

    public SFLibraryFunction Function { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFLibrary? @class = Storage.Documentation.Libraries.GetValueOrDefault(LibraryName);
        if (@class == null)
        {
            Navigation.NotFound();
            return;
        }

        Function = @class.Functions.GetValueOrDefault(FunctionName)!;
        if (Function == null)
        {
            Navigation.NotFound();
            return;
        }
    }

    private string GetSignature(bool includeParams = true)
    {
        string paramList = includeParams ? string.Join(", ", Function.Parameters.Select(p => p.Name)) : string.Empty;

        if (Function.Parent.Name == "builtin") return $"function {Function.Name}({paramList})";
        return $"{(includeParams ? "function " : string.Empty)}{Function.Parent.Name}.{Function.Name}({paramList})";
    }
}