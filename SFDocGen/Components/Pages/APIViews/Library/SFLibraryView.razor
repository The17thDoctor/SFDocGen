@page "/ref/library/{LibraryName}"

<CustomPageTitle Title="@Library.Name" />

<MudTooltip Placement="Placement.Right" Arrow Text="Library">
    <div class="d-flex flex-row mud-secondary-text">
        <MudIcon Class="my-auto mr-1" Icon="@Icons.Material.Filled.Class" Size="Size.Large" />
        <MudText Typo="Typo.h4">@Library.Name</MudText>
    </div>
</MudTooltip>

<MudText Typo="Typo.body1">@Library.Description</MudText>
<MudDivider/>

@code {
    [Parameter]
    public string LibraryName { get; set; } = string.Empty;
    public SFLibrary Library { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Library = Storage.Documentation.Libraries.GetValueOrDefault(LibraryName)!;
        if (Library == null)
        {
            Navigation.NotFound();
            return;
        }
    }
}
