@page "/ref/library/{LibraryName}/table/{TableName}"
@using SFDocGen.Components.UI

<CustomPageTitle Title="@GetSignature()" />

<MudTooltip Placement="Placement.Right" Arrow Text="Table">
    <div class="d-flex flex-row mud-secondary-text">
        <MudIcon Class="my-auto mr-1" Icon="@Icons.Material.Filled.DataArray" Size="Size.Large" />
        <MudText Typo="Typo.h4">@GetSignature()</MudText>
    </div>
</MudTooltip>

<MudDivider />

<MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
    <CodeHighlight CodeLanguage="lua" Code="@GetSignature()" />

    <MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
        <RealmText Value="@Table" />

        
        @foreach (string line in (Table.Description ?? string.Empty).Split("\n"))
        {
            <MudText Typo="Typo.body1">@line</MudText>
        }

        <br />

        @if (Table.Usage != null)
        {
            <MudText Color="Color.Tertiary" Typo="Typo.h6">Usage</MudText>
            <CodeHighlight CodeLanguage="lua" Code="@Table.Usage" />
        }
    </MudContainer>
</MudContainer>


@code {
    [Parameter]
    public string TableName { get; set; } = string.Empty;

    [Parameter]
    public string LibraryName { get; set; } = string.Empty;

    public SFLibraryTable Table { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFLibrary? library = Storage.Documentation.Libraries.GetValueOrDefault(LibraryName);
        if (library == null)
        {
            Navigation.NotFound();
            return;
        }

        Table = library.Tables.GetValueOrDefault(TableName)!;
        if (Table == null)
        {
            Navigation.NotFound();
            return;
        }
    }

    private string GetSignature()
    {
        if (Table.Parent.Name == "builtin") return Table.Name ?? string.Empty;
        return $"{Table.Parent.Name}.{Table.Name}";
    }
}