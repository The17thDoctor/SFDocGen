@page "/api/class/{ClassName}/method/{MethodName}"
@using SFDocGen.Components.UI

<CustomPageTitle Title="@GetSignature()" />

<MudTooltip Placement="Placement.Right" Arrow Text="Field">
    <div class="d-flex flex-row mud-secondary-text">
        <MudIcon Class="my-auto mr-1" Icon="@Icons.Material.Filled.DataObject" Size="Size.Large" />
        <MudText Typo="Typo.h4">@GetSignature(includeParams: false)</MudText>
    </div>
</MudTooltip>

<MudDivider />

<MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
    <CodeHighlight CodeLanguage="lua" Code="@GetSignature()" />

    <MudContainer Class="pt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
        <RealmText Value="@Method" />

        
        @foreach (string line in (Method.Description ?? string.Empty).Split("\n"))
        {
            <MudText Typo="Typo.body1">@line</MudText>
        }

        <br />

        @if (Method.Parameters.Any())
        {
            <MudText Color="Color.Tertiary" Typo="Typo.h6">Parameters</MudText>
            @foreach (var parameter in Method.Parameters)
            {
                <ParameterView Parameter="parameter" />
            }
            <br />
        }

        @if (Method.Usage != null)
        {
            <MudText Color="Color.Tertiary" Typo="Typo.h6">Usage</MudText>
            <CodeHighlight CodeLanguage="lua" Code="@Method.Usage" />
        }
    </MudContainer>
</MudContainer>


@code {
    [Parameter]
    public string MethodName { get; set; } = string.Empty;

    [Parameter]
    public string ClassName { get; set; } = string.Empty;

    public SFClassMethod Method { get; set; } = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SFClass? @class = Storage.Documentation.Classes.GetValueOrDefault(ClassName);
        if (@class == null)
        {
            Navigation.NotFound();
            return;
        }

        Method = @class.Methods.GetValueOrDefault(MethodName)!;
        if (Method == null)
        {
            Navigation.NotFound();
            return;
        }
    }

    private string GetSignature(bool includeParams = true)
    {
        string paramList = includeParams ? string.Join(", ", Method.Parameters.Select(p => p.Name)) : string.Empty;
        return $"{(includeParams ? "function " : string.Empty)}{Method.Parent.Name}:{Method.Name}({paramList})";
    }
}